<?xml version="1.0"?>
<robot name="hz_hunter_core" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Nominal geometry from car-exported HunterV2Params; not measured. -->
  <xacro:arg name="wheelbase" default="0.650"/>
  <xacro:arg name="track" default="0.605"/>
  <xacro:arg name="wheel_radius" default="0.165"/>
  <xacro:arg name="steering_limit" default="0.58"/>
  <xacro:property name="wheelbase" value="$(arg wheelbase)"/>
  <xacro:property name="track" value="$(arg track)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="steering_limit" value="$(arg steering_limit)"/>

  <!-- Prototype assumptions. See README; none are measured vehicle values. -->
  <xacro:arg name="chassis_mass" default="50.0"/>
  <xacro:arg name="wheel_mass" default="2.0"/>
  <xacro:arg name="knuckle_mass" default="1.0"/>
  <xacro:property name="chassis_mass" value="$(arg chassis_mass)"/>
  <xacro:property name="wheel_mass" value="$(arg wheel_mass)"/>
  <xacro:property name="knuckle_mass" value="$(arg knuckle_mass)"/>
  <xacro:property name="body_length" value="1.00"/>
  <xacro:property name="body_width" value="0.46"/>
  <xacro:property name="body_height" value="0.18"/>
  <xacro:property name="body_z" value="0.12"/>
  <xacro:property name="wheel_width" value="0.12"/>
  <xacro:property name="knuckle_size" value="0.05"/>
  <xacro:property name="hz_pi" value="3.141592653589793"/>

  <material name="chassis_gray"><color rgba="0.65 0.68 0.72 1"/></material>
  <material name="tire_black"><color rgba="0.07 0.07 0.08 1"/></material>

  <xacro:macro name="box_inertia" params="mass length width height xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (width**2 + height**2) / 12.0}"
               iyy="${mass * (length**2 + height**2) / 12.0}"
               izz="${mass * (length**2 + width**2) / 12.0}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- base_link is the rear axle midpoint, at wheel center height. -->
  <link name="base_link">
    <xacro:box_inertia mass="${chassis_mass}" length="${body_length}"
                       width="${body_width}" height="${body_height}"
                       xyz="${wheelbase / 2.0} 0 ${body_z}"/>
    <visual>
      <origin xyz="${wheelbase / 2.0} 0 ${body_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="chassis_gray"/>
    </visual>
    <collision>
      <origin xyz="${wheelbase / 2.0} 0 ${body_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name parent x y">
    <link name="${name}_wheel">
      <!-- Cylinder axis is Y in the link frame. -->
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12.0}"
                 iyy="${wheel_mass * wheel_radius**2 / 2.0}"
                 izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12.0}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="${hz_pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tire_black"/>
      </visual>
      <collision>
        <origin rpy="${hz_pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20.0" velocity="${1.5 / wheel_radius}"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front_corner" params="side y">
    <link name="front_${side}_knuckle">
      <xacro:box_inertia mass="${knuckle_mass}" length="${knuckle_size}"
                         width="${knuckle_size}" height="${knuckle_size}"
                         xyz="0 0 0"/>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${wheelbase} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}"
             effort="10.0" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
    <xacro:wheel name="front_${side}" parent="front_${side}_knuckle" x="0" y="0"/>
  </xacro:macro>

  <xacro:wheel name="rear_left" parent="base_link" x="0" y="${track / 2.0}"/>
  <xacro:wheel name="rear_right" parent="base_link" x="0" y="${-track / 2.0}"/>
  <xacro:front_corner side="left" y="${track / 2.0}"/>
  <xacro:front_corner side="right" y="${-track / 2.0}"/>
</robot>
