<?xml version="1.0"?>
<package format="3">
  <name>hunter_nav_odom</name>
  <version>0.0.0</version>
  <description>Hunter odometry-based mapping and navigation bringup.</description>

  <maintainer email="car@todo.todo">car</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <exec_depend>hunter_description</exec_depend>
  <exec_depend>hunter_base</exec_depend>
  <exec_depend>robot_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
